{% extends 'base.html.twig' %}

{% block title %}Administration{% endblock %}

{% block body %}
    {% set logout = {
        action: path('app_logout'),
        csrfToken: csrf_token('logout')
    } %}

    <div
        id="admin-shell"
        {{ vue_component('AdminShell', {
            brand: app_brand,
            logoutUrl: logout.action,
            logoutCsrfToken: logout.csrfToken
        }) }}
    ></div>

    <noscript>
        <main>
            <h1>Administration</h1>

            <form method="post" action="{{ logout.action }}">
                <input type="hidden" name="_csrf_token" value="{{ logout.csrfToken }}">
                <button type="submit">Sign out</button>
            </form>
        </main>
    </noscript>
{% endblock %}
