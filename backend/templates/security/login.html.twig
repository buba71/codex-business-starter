{% extends 'base.html.twig' %}

{% block title %}Administrator sign in{% endblock %}

{% block body %}
    <main>
        <h1>Administrator sign in</h1>

        {% if error %}
            <p role="alert">{{ error.messageKey }}</p>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}">
            <label for="email">Email</label>
            <input id="email" name="_username" type="email" value="{{ last_username }}" autocomplete="email" required autofocus>

            <label for="password">Password</label>
            <input id="password" name="_password" type="password" autocomplete="current-password" required>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit">Sign in</button>
        </form>
    </main>
{% endblock %}
